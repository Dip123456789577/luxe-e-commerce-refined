# LUXE Maison d’Artisan — Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8080

# Database Configuration
# Leave blank to automatically use the zero-friction in-memory MongoDB instance for local dev/testing.
# For production, provide your MongoDB Atlas or remote connection URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/luxe_store?retryWrites=true&w=majority
MONGODB_URI=

# Cryptographic & Session Secrets
JWT_SECRET=luxe_atelier_super_secure_jwt_secret_key_2026_dev_mode
JWT_EXPIRES_IN=7d
COOKIE_SECRET=luxe_cookie_signing_secret_key_2026

# Payment Gateway Integrations (Optional for demo mode)
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Transactional Concierge Email Service (SMTP)
# If blank, the server automatically outputs simulated luxury email monographs to the development console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=concierge@atelier-luxe.com
